# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific
*.translation
*.import
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.import

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# System/tool-specific
.env
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*~

# Build/export directories
builds/
exports/
dist/

# Logs
*.log
logs/

# IDE-specific
.vscode/
.idea/
*.swp
*.swo
*.swn

# Temporary files
*.tmp
tmp/

# Test configuration (contains credentials)
.env.test

# Service PID files
.pids/

# API environment
api/.env

# Deploy target config (server IP / SSH user) — local only, never committed
deployment/deploy.env

# Load test reports (omega-load-test writes report_<timestamp>.json to the CWD)
report_*.json

# Rust GDExtension build artifacts (rebuilt by scripts/build_client_ext.sh)
client/bin/macos/*.dylib
client/bin/linux/*.so
client/bin/windows/*.dll

# Compiled Go API binary (built by scripts/build_api.sh)
api/bin/

# CMS Website
/web
