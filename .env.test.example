# Test login configuration — copy to .env.test and adjust.
#
# This file is ONLY for the local test login used by:
#   - scripts/seed_test_user.sh (creates/updates this user in PostgreSQL)
#   - client smoke/login test scenes (client/scripts/shared/test_config.gd)
#
# It is NOT runtime config:
#   - API / database / Redis config lives in api/.env (see api/.env.example)
#   - Docker deployment config lives in deployment/.env.production

# =============================================================================
# TEST USER CREDENTIALS (dev-only values — never reuse real passwords)
# =============================================================================

TEST_USERNAME=testuser
TEST_PASSWORD=testpassword123

# Email for the seeded user (optional; defaults to <username>@example.test)
#TEST_EMAIL=

# Character to auto-select in test scenes (leave empty to use first character)
TEST_CHARACTER_NAME=

# Realm/region for the seeded user and test login (Asia, Europe, US-West)
TEST_REALM=Asia

# =============================================================================
# ENDPOINTS THE TEST SCENES CONNECT TO
# =============================================================================

# Go API (auth, characters)
API_SERVER_URL=http://localhost:8080

# Rust game server (ENet/UDP)
GAME_SERVER_HOST=localhost
GAME_SERVER_PORT=8081
