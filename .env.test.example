# Test Environment Configuration
# Copy this file to .env.test and fill in your credentials

# =============================================================================
# TEST USER CREDENTIALS
# =============================================================================

# Login credentials for automated testing
TEST_USERNAME=testuser
TEST_PASSWORD=testpassword123

# Character to auto-select (leave empty to use first character)
TEST_CHARACTER_NAME=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Realm to connect to (Asia, Europe, US-West)
TEST_REALM=Asia

# API Server URL (Go backend)
API_SERVER_URL=http://localhost:8080

# Godot Game Server Host and Port
GAME_SERVER_HOST=localhost
GAME_SERVER_PORT=8081

# =============================================================================
# DATABASE (Reference only - managed manually)
# =============================================================================

# These are for reference - database is managed externally
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omega_db
DB_USER=omega
DB_PASSWORD=omega_password

# =============================================================================
# SERVICE PATHS (for start/stop scripts)
# =============================================================================

# Path to Godot executable (auto-detected if in PATH)
GODOT_PATH=/Applications/Godot.app/Contents/MacOS/Godot

# Path to Go executable (auto-detected if in PATH)
GO_PATH=go
