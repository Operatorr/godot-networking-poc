# Optional FUTURE signed-ticket setup; the current isolated dev tests need no API.
# Copy to auth.local.env (ignored by Git) and chmod 600 before filling values.
# This stays on the operator computer; never upload the whole file to a game host.

# Existing Go API origin used by the bots for POST /api/loadtest/ticket.
OMEGA_TICKET_API=https://gsapi.marrowtech.app

# Match the existing API's LOAD_TEST_TICKET_SECRET. Used only by the bot generator.
OMEGA_LOAD_TEST_SECRET=

# Match the existing API's Ed25519 verification PUBLIC key: 64 hex characters.
# Used by the game hosts; different from the SSH key uploaded to Hetzner.
OMEGA_TICKET_PUBKEY=
