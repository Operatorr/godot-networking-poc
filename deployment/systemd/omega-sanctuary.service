[Unit]
Description=Omega Realm SANCTUARY instance (Rust omega-server, ENet/UDP 8082, metrics 9101)
Documentation=https://github.com/Operatorr/godot-networking-poc
After=network-online.target omega-api.service
Wants=network-online.target omega-api.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/omega-realm/rust
EnvironmentFile=/etc/omega-realm/server.env
ExecStart=/home/deploy/omega-realm/rust/target/release/omega-server --config /home/deploy/omega-realm/deployment/server_config.sanctuary.json
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
