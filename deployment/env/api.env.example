# Omega Realm API — production runtime env (native deploy).
# provision_server.sh installs this to /etc/omega-realm/api.env (root:deploy 0640).
# Edit the installed copy with real secrets; this template is safe to commit.
#
# Consumed by the omega-api systemd unit via EnvironmentFile=. The Go API also
# calls godotenv.Load(), but env vars set here take precedence, so no repo .env
# is needed in production.

# --- Server ---
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info

# --- PostgreSQL (native, local) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=omega
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
DB_NAME=omega_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=10m

# --- Redis (native, local) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_SECRET
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# --- Regions ---
AVAILABLE_REGIONS=Asia,Europe,US-West
DEFAULT_REGION=Asia
