# Omega Realm API — production runtime env (native deploy).
# provision_server.sh installs this to /etc/omega-realm/api.env (root:deploy 0640).
# Edit the installed copy with real secrets; this template is safe to commit.
#
# Consumed by the omega-api systemd unit via EnvironmentFile=. The Go API also
# calls godotenv.Load(), but env vars set here take precedence, so no repo .env
# is needed in production.

# --- Server ---
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info

# --- PostgreSQL (native, local) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=omega
DB_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
DB_NAME=omega_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=10m

# --- Redis (native, local) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
# Signing secret for access/refresh tokens. REQUIRED in production: with ENVIRONMENT=production
# the API refuses to start if this is empty or left at a placeholder (forging tokens would
# otherwise be trivial). Generate with:  openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_SECRET
# Token lifetimes. Go durations (e.g. 15m, 1h) plus a "d" (days) / "w" (weeks) suffix.
# Unset or unparseable falls back to 24h access / 7d refresh.
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# --- Regions ---
AVAILABLE_REGIONS=Asia,Europe,US-West
DEFAULT_REGION=Asia
# Per-region game-server connect address (bare host:port for the ENet/UDP server — no scheme,
# no TLS; ADR 0003). The API hands this to the client after region select. A live game-server
# heartbeat's advertise_url OVERRIDES these at runtime, so they are only the fallback shown
# when a server is up but has not advertised its own address. Leave unset to rely purely on
# the heartbeat. Example multi-region map (Frankfurt = europe, Singapore = asia):
#   REGION_EUROPE_URL=fra.omega.marrowtech.app:8081
#   REGION_ASIA_URL=sgp.omega.marrowtech.app:8081
REGION_LOCAL_URL=localhost:8081
REGION_ASIA_URL=
REGION_EUROPE_URL=
REGION_US_WEST_URL=

# --- Internal server-to-server auth ---
# Shared secret the authoritative Rust game server sends (X-Server-Token) when
# calling /api/internal/* to read/write progression and settle Glory on death.
# MUST match SERVER_API_TOKEN in the game server's env (server.env). REQUIRED in
# production: if unset, /api/internal/* fails closed (503) unless
# ALLOW_INSECURE_INTERNAL=true is also set (local dev only — never in production).
# Generate with:  openssl rand -hex 32
SERVER_API_TOKEN=CHANGE_ME_TO_A_SECURE_TOKEN
# REGION_HEARTBEAT_TOKEN — shared secret for the region heartbeat endpoint.
# Generate with:  openssl rand -hex 32   (use a DIFFERENT value than SERVER_API_TOKEN)
REGION_HEARTBEAT_TOKEN=CHANGE_ME_TO_A_SECURE_TOKEN

# --- Session-ticket signing (D9) ---
# The API mints short-lived Ed25519 session tickets at POST /api/character/ticket; the
# game server verifies them locally with the PUBLIC half (OMEGA_TICKET_PUBKEY in
# server.env). This is the PRIVATE half: a 32-byte Ed25519 seed (hex). Generate a pair
# with `go run ./cmd/gen_ticket_key` (from api/) — it prints both this and the matching
# OMEGA_TICKET_PUBKEY. Keep this secret; never commit it.
# Empty disables signing: the ticket endpoint returns 503 and clients must join unsigned
# (the game server must then run with --allow-unsigned-tickets).
OMEGA_TICKET_PRIVKEY=
# Ticket lifetime in seconds (default 60). No revocation list — expiry IS the revocation
# story — so keep this short (seconds to a few minutes).
OMEGA_TICKET_TTL_SECONDS=60
