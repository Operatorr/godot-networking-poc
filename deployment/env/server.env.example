# Omega Realm game server — production runtime env (native deploy), SHARED by
# both the omega-arena and omega-sanctuary units via EnvironmentFile=.
# provision_server.sh installs this to /etc/omega-realm/server.env (root:deploy 0640).
#
# These override the JSON config where they overlap (env wins — see
# rust/server/src/config.rs apply_env_overrides). Keep only settings that are
# the SAME for both instances here.
#
# DO NOT set GAME_SERVER_PORT here: env wins over config, so it would force BOTH
# instances onto the same port. Ports/modes/metrics_port come from each
# instance's config file (server_config.arena.json / server_config.sanctuary.json).

# Sim tick rate (Hz). Leave unset to use the JSON config (30).
# GAME_SERVER_TICK_RATE=30

# --- Auth tickets ---
# Production default: FAIL CLOSED — require signed tickets. To accept them you must also
# provide OMEGA_TICKET_PUBKEY (the Ed25519 public key, hex, 32 bytes). The Go API mints
# tickets and holds the private half; generate the pair with `go run ./cmd/gen_ticket_key`
# (from api/), which prints the matching OMEGA_TICKET_PRIVKEY (-> api.env) and the
# OMEGA_TICKET_PUBKEY below. The running API also logs its public key at startup.
# Dev / load-test opts INTO ticket-less bots explicitly (scripts/dev_local.sh passes
# --allow-unsigned-tickets; the load-test harness sets this true) so the swarm can connect
# without minting tickets. Never set true in production.
#
# NOTE: the GAME CLIENT does not yet fetch/present tickets (M3) — until it does, real
# players also join unsigned, so a player-facing deploy needs unsigned=true. Load/CI and
# the server↔server path are unaffected.
OMEGA_ALLOW_UNSIGNED_TICKETS=false
OMEGA_TICKET_PUBKEY=

# Tokens for the API heartbeat / progression calls. MUST match the same-named keys in
# api.env. Empty = the server sends no token; the API then rejects those calls (503/401)
# unless it runs with ALLOW_INSECURE_INTERNAL=true. Generate with: openssl rand -hex 32
REGION_HEARTBEAT_TOKEN=
SERVER_API_TOKEN=
