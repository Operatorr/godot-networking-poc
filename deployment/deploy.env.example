# Deploy target for scripts/deploy.sh — copy to deployment/deploy.env and fill in.
#
#   cp deployment/deploy.env.example deployment/deploy.env
#   # edit deployment/deploy.env with your droplet's IP
#
# deployment/deploy.env is GIT-IGNORED, so your server IP never lands in the repo.
# scripts/deploy.sh sources it automatically. Anything you also export in your shell
# (e.g. `OMEGA_HOST=1.2.3.4 ./scripts/deploy.sh`) takes precedence over this file.

# REQUIRED — the droplet's public IP or hostname.
OMEGA_HOST=

# SSH user (the deploy account). Default if unset: deploy
OMEGA_USER=deploy

# Branch the server pulls + builds. Default if unset: master
OMEGA_BRANCH=master

# Where the repo lives on the server. Default if unset: /home/<OMEGA_USER>/omega-realm
# OMEGA_REPO_DIR=/home/deploy/omega-realm
