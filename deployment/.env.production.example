# Omega Realm - Production Environment Configuration
# Copy to .env.production and fill in secure values before deploying

# --- Database ---
DB_USER=omega_prod
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DB_NAME=omega_realm
DB_SSLMODE=disable

# --- API Server ---
API_PORT=8080
JWT_SECRET=CHANGE_ME_TO_SECURE_SECRET
JWT_EXPIRY_HOURS=24
LOG_LEVEL=info

# --- Game Server ---
GAME_SERVER_PORT=8081

# --- General ---
ENVIRONMENT=production
