 impl<S: Socket> Host<S> {
+    /// Enable the diagnostic-only input counters before using a single-peer host.
+    pub fn enable_input_diagnostic(&mut self) -> Result<(), &'static str> {
+        if self.peers.len() != 1 {
+            return Err("input diagnostic requires a single-peer host");
+        }
+        if self.peers[0].state() != PeerState::Disconnected {
+            return Err("input diagnostic must be enabled before connecting");
+        }
+        unsafe { (*self.host).input_diagnostic.enabled = true; }
+        Ok(())
+    }
+
+    /// Cumulative counters persist across peer reset and disconnect.
+    pub fn input_counters(&self) -> crate::InputCounters {
+        unsafe { (*self.host).input_diagnostic.counters }
+    }
