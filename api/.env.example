# Local API runtime configuration — copy to api/.env and adjust.
#
# The Go API loads this file from its working directory; scripts/dev_local.sh and
# scripts/seed_test_user.sh both rely on it. Point DB_*/REDIS_* at your locally
# running PostgreSQL and Redis (e.g. DBngin) — nothing here starts them for you.
# All values below are local dev defaults, not production secrets
# (production deploy config lives in /etc/omega-realm/api.env on the server —
#  template deployment/env/api.env.example; see deployment/DEPLOYMENT.md).

# Server Configuration
PORT=8080

# Database Configuration (local PostgreSQL, e.g. DBngin)
DB_HOST=localhost
DB_PORT=5432
DB_USER=omega
DB_PASSWORD=omega_password
DB_NAME=omega_db
DB_SSLMODE=disable

# Database Connection Pool Settings
DB_MAX_OPEN_CONNS=25          # Maximum number of open connections
DB_MAX_IDLE_CONNS=5           # Maximum number of idle connections
DB_CONN_MAX_LIFETIME=5m       # Maximum lifetime of a connection (e.g., 5m, 1h)
DB_CONN_MAX_IDLE_TIME=10m     # Maximum idle time of a connection (e.g., 10m, 30m)

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m   # Access token expiry (e.g., 15m, 1h)
JWT_REFRESH_TOKEN_EXPIRY=7d   # Refresh token expiry (e.g., 7d, 30d)

# Server Regions
AVAILABLE_REGIONS=Asia,Europe,US-West
DEFAULT_REGION=Asia

# Redis Configuration (required — the API exits on startup if unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Internal server-to-server auth (/api/internal/* — progression + Glory settlement).
# In production, set SERVER_API_TOKEN to a shared secret matching the game server.
# For local dev we leave it blank and opt into the unauthenticated path explicitly:
# without one of these, /api/internal/* fails closed with 503.
SERVER_API_TOKEN=
ALLOW_INSECURE_INTERNAL=true

# Session-ticket signing (D9) — usually BLANK for local dev. Local servers run unsigned
# (scripts/dev_local.sh passes --allow-unsigned-tickets), so the API doesn't need to sign and
# these stay empty. Set them only to exercise the SIGNED path locally (a server started with
# --require-tickets + a matching OMEGA_TICKET_PUBKEY). OMEGA_TICKET_PRIVKEY is a 32-byte Ed25519
# seed (hex) — generate a pair with `go run ./cmd/gen_ticket_key` (it prints both halves).
# (Production sets these in /etc/omega-realm/api.env — template deployment/env/api.env.example.)
OMEGA_TICKET_PRIVKEY=
OMEGA_TICKET_TTL_SECONDS=60

# Load-test ticket endpoint (POST /api/loadtest/ticket). Shared secret the bot swarm
# (rust/load_test, run with --live / OMEGA_LOAD_TEST_SECRET) presents to mint signed tickets for
# SYNTHETIC character_ids (>= 1,000,000) — no real account, and the game server keeps those ids
# out of all DB I/O. EMPTY = endpoint disabled (503). Minting also REQUIRES OMEGA_TICKET_PRIVKEY
# above to be set (secret without a signing key still 503s). Generate with: openssl rand -hex 32
LOAD_TEST_TICKET_SECRET=

# Content CMS (/api/content/*, /api/admin/balance/* — designer-only editor API).
# Endpoints require an authenticated user with users.is_admin = true. Grant real
# admin (the production path) with:
#   UPDATE users SET is_admin = true WHERE username = '<name>';
# Secure by default: leave ALLOW_INSECURE_CMS unset/false everywhere except local
# dev. Uncomment ONLY on your machine to bypass the admin check so any logged-in
# user can edit content — NEVER set this in production.
# ALLOW_INSECURE_CMS=true

# Optional CDN origin for published content artifacts. Publish records the artifact
# path as <CONTENT_CDN_URL>/<kind>/<version>.json; when unset it falls back to the
# relative "/content" prefix served by the API host.
# CONTENT_CDN_URL=https://cdn.example.com/content
