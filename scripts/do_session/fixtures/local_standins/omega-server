#!/usr/bin/env python3
"""Offline stand-in for omega-server: a real process holding a real UDP socket. It measures nothing."""
import argparse
import json
import os
import signal
import socket
import sys
import time

parser = argparse.ArgumentParser()
parser.add_argument('--config')
parser.add_argument('--mode')
parser.add_argument('--port', type=int, required=True)
parser.add_argument('--allow-unsigned-tickets', action='store_true')
parser.add_argument('--crash-after-first-datagram', type=float)
parser.add_argument('--ignore-term', action='store_true')
args = parser.parse_args()
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
sock.bind(('127.0.0.1', args.port))
sock.settimeout(0.1)
stop = []
signal.signal(signal.SIGTERM, (lambda *_: None) if args.ignore_term else (lambda *_: stop.append(True)))
first_datagram = None
received = 0
while not stop:
    try:
        sock.recv(2048)
        received += 1
        first_datagram = first_datagram or time.monotonic()
    except socket.timeout:
        pass
    if args.crash_after_first_datagram is not None and first_datagram and time.monotonic() - first_datagram >= args.crash_after_first_datagram:
        os._exit(101)
with open('game-summary.json', 'w') as handle:
    json.dump(dict(received=received), handle)
sys.exit(0)
