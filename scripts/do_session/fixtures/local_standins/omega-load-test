#!/usr/bin/env python3
"""Offline stand-in for the swarm: a real process sending real datagrams, then a report. It measures nothing."""
import argparse
import json
import os
import socket
import sys
import time

parser = argparse.ArgumentParser()
parser.add_argument('--server', required=True)
parser.add_argument('--bots', type=int)
parser.add_argument('--duration', type=float, required=True)
parser.add_argument('--output', required=True)
parser.add_argument('--crash-after', type=float)
parser.add_argument('--no-report', action='store_true')
parser.add_argument('--hang', action='store_true')
args = parser.parse_args()
host, port = args.server.rsplit(':', 1)
sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
started = time.monotonic()
sent = 0
failed = 0
while args.hang or time.monotonic() - started < args.duration:
    try:
        sock.sendto(b'x', (host, int(port)))
        sent += 1
    except OSError:     # macOS loopback can answer ENOBUFS under load; a real swarm counts these too
        failed += 1
    if args.crash_after is not None and time.monotonic() - started >= args.crash_after:
        os._exit(77)
    time.sleep(0.02)
if not args.no_report:
    with open(args.output, 'w') as handle:
        json.dump(dict(requested=args.bots, sent=sent, failed=failed), handle)
sys.exit(0)
