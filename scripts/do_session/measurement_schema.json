    "rtt_min_coverage": 0.9,
    "clock_drift_ppm": 200,
    "clock_step_ms": 100,
    "clock_max_half_width_ms": 2000,
    "pair_max_age_s": 5,
    "collector_max_gap_s": 5
  },
  "files": {
    "bot": ["swarm/swarm.json", "swarm/coordinator.ndjson", "swarm/window.json", "swarm/shard-<k>.ndjson", "sampler.ndjson", "report.json (legacy whole-run diagnostic)"],
    "game": ["telemetry/process.json", "telemetry/population.ndjson", "telemetry/ticks.csv", "telemetry/server.ndjson", "telemetry/final.json", "sampler.ndjson", "sockets.ndjson"],
    "controller": ["clock-before.json", "clock-after.json", "window-proof.json"]
  }
}
