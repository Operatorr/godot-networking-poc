[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_autojoinarena"]
script/source = "## AutoJoinArena - Bootstrapper that logs in and joins a networked arena
## Reads credentials from .env.test, authenticates, connects WebSocket, then
## hands off to SceneManager.goto_arena() which loads arena_base.tscn with
## full client setup (camera, interpolation, entity manager, HUD, prediction).
## Usage: Run this scene (F6) to skip the UI and jump straight into a game.
extends Node2D

## Test states
enum TestState {
	INITIALIZING,
	LOADING_CONFIG,
	LOGGING_IN,
	CONNECTING,
	ENTERING_ARENA,
	ERROR
}

## Current test state
var state: TestState = TestState.INITIALIZING

## Test configuration
var config: TestConfig = null

## UI references
@onready var status_label: Label = $UI/StatusLabel
@onready var error_label: Label = $UI/ErrorLabel


func _ready() -> void:
	_update_status(\"Initializing...\")

	# Wait for autoloads to be ready
	await get_tree().process_frame
	await get_tree().process_frame

	_start_test()


func _start_test() -> void:
	state = TestState.LOADING_CONFIG
	_update_status(\"Loading test configuration...\")

	# Load config from .env.test
	config = TestConfig.new()
	if not config.load_config():
		_show_error(\"Failed to load .env.test file\\n\\nPlease create .env.test from .env.test.example\")
		return

	if not config.is_valid():
		_show_error(\"Invalid configuration - missing username or password\")
		return

	config.print_config()

	# Configure API URL
	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if not auth_mgr:
		_show_error(\"AuthManager autoload not found\")
		return
	auth_mgr.set_api_url(config.api_server_url)

	# Start login
	_do_login()


func _do_login() -> void:
	state = TestState.LOGGING_IN
	_update_status(\"Logging in as %s...\" % config.username)

	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if not auth_mgr:
		_show_error(\"AuthManager not found\")
		return

	# Connect signals (one-shot via callable)
	if not auth_mgr.login_successful.is_connected(_on_login_successful):
		auth_mgr.login_successful.connect(_on_login_successful)
	if not auth_mgr.login_failed.is_connected(_on_login_failed):
		auth_mgr.login_failed.connect(_on_login_failed)

	auth_mgr.login(config.username, config.password)


func _on_login_successful(user_data: Dictionary) -> void:
	print(\"[AutoJoinArena] Login successful: %s\" % user_data)

	# Disconnect login signals
	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if auth_mgr:
		if auth_mgr.login_successful.is_connected(_on_login_successful):
			auth_mgr.login_successful.disconnect(_on_login_successful)
		if auth_mgr.login_failed.is_connected(_on_login_failed):
			auth_mgr.login_failed.disconnect(_on_login_failed)

	# AuthManager.set_player_data() already populates GameManager.player_data
	# with character_name, character_id, user_id from the API response.

	var char_name: String = user_data.get(\"character_name\", \"\")
	if char_name.is_empty():
		_show_error(\"No character found for this account.\\nCreate a character first via the normal UI.\")
		return

	_update_status(\"Logged in as %s (Character: %s)\" % [user_data.get(\"username\", \"?\"), char_name])

	# Override selected_region from test config if set
	if not config.realm.is_empty():
		GameManager.player_data[\"selected_region\"] = config.realm

	# Connect to game server
	await get_tree().create_timer(0.3).timeout
	_connect_to_server()


func _connect_to_server() -> void:
	state = TestState.CONNECTING
	var ws_url := \"ws://%s:%d\" % [config.game_server_host, config.game_server_port]
	_update_status(\"Connecting to %s...\" % ws_url)

	# Set auth token so the handshake includes it
	NetworkManager.auth_token = AuthManager.get_token()

	# Connect NetworkManager signals
	if not NetworkManager.connected_to_server.is_connected(_on_connected_to_server):
		NetworkManager.connected_to_server.connect(_on_connected_to_server)
	if not NetworkManager.connection_error.is_connected(_on_connection_error):
		NetworkManager.connection_error.connect(_on_connection_error)

	NetworkManager.connect_to_server(ws_url)


func _on_connected_to_server() -> void:
	print(\"[AutoJoinArena] Connected to server\")

	# Disconnect signals (arena will handle reconnection)
	if NetworkManager.connected_to_server.is_connected(_on_connected_to_server):
		NetworkManager.connected_to_server.disconnect(_on_connected_to_server)
	if NetworkManager.connection_error.is_connected(_on_connection_error):
		NetworkManager.connection_error.disconnect(_on_connection_error)

	state = TestState.ENTERING_ARENA
	_update_status(\"Connected! Entering arena...\")

	# Brief delay then transition to arena (same as main_menu.gd)
	await get_tree().create_timer(0.5).timeout
	SceneManager.goto_arena()


func _on_login_failed(error: String) -> void:
	print(\"[AutoJoinArena] Login failed: %s\" % error)

	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if auth_mgr:
		if auth_mgr.login_successful.is_connected(_on_login_successful):
			auth_mgr.login_successful.disconnect(_on_login_successful)
		if auth_mgr.login_failed.is_connected(_on_login_failed):
			auth_mgr.login_failed.disconnect(_on_login_failed)

	_show_error(\"Login failed: %s\" % error)


func _on_connection_error(error: String) -> void:
	print(\"[AutoJoinArena] Connection error: %s\" % error)

	if NetworkManager.connected_to_server.is_connected(_on_connected_to_server):
		NetworkManager.connected_to_server.disconnect(_on_connected_to_server)
	if NetworkManager.connection_error.is_connected(_on_connection_error):
		NetworkManager.connection_error.disconnect(_on_connection_error)

	_show_error(\"Connection failed: %s\\n\\nEnsure the game server is running:\\n  ./scripts/start_services.sh --game-only\" % error)


func _update_status(text: String) -> void:
	if status_label:
		status_label.text = text
	print(\"[AutoJoinArena] %s\" % text)


func _show_error(text: String) -> void:
	state = TestState.ERROR
	if error_label:
		error_label.text = \"ERROR: %s\" % text
		error_label.visible = true
	_update_status(\"Failed\")
	push_error(\"[AutoJoinArena] %s\" % text)
"

