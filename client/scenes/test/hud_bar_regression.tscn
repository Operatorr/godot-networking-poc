[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="GDScript_hud_bar_regression"]
script/source = "extends Node

# Regression for the TextureProgressBar-backed health bar (scenes/ui/hud/health_bar.tscn).
const HealthBarScene := preload(\"res://scenes/ui/hud/health_bar.tscn\")


func _ready() -> void:
	var hp_bar := HealthBarScene.instantiate()
	add_child(hp_bar)
	await get_tree().process_frame

	hp_bar.update_hp(40, 100)
	await get_tree().process_frame

	var expected_ratio := 0.4
	var actual_ratio: float = hp_bar.get_fill_ratio()
	if not is_equal_approx(actual_ratio, expected_ratio):
		push_error(\"Expected HP fill ratio %.2f, got %.2f\" % [expected_ratio, actual_ratio])
		get_tree().quit(1)
		return

	# The TextureProgressBar IS the trough, so the fill can never exceed it by construction;
	# assert it stays within the bar's authored 300px width.
	var fill_size: Vector2 = hp_bar.get_fill_size()
	if fill_size.x > 300.0:
		push_error(\"HP fill width %.2f exceeds bar width 300\" % fill_size.x)
		get_tree().quit(1)
		return

	print(\"[HUDBarRegression] PASS\")
	get_tree().quit(0)
"

[node name="HUDBarRegression" type="Node"]
script = SubResource("GDScript_hud_bar_regression")
