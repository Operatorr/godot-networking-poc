[sub_resource type="GDScript" id="GDScript_autologin"]
script/source = "## AutoLoginTest - Automated test that logs in and joins the game
## Reads credentials from .env.test file
## Usage: Run this scene to automatically log in and spawn the player
extends Node2D

const TestConfigScript := preload(\"res://scripts/shared/test_config.gd\")

## Test states
enum TestState {
	INITIALIZING,
	LOADING_CONFIG,
	LOGGING_IN,
	SELECTING_CHARACTER,
	CONNECTING_TO_REALM,
	SPAWNING_PLAYER,
	READY,
	ERROR
}

## Current test state
var state: TestState = TestState.INITIALIZING

## Test configuration
var config = null

## Status label reference
@onready var status_label: Label = $UI/StatusLabel
@onready var error_label: Label = $UI/ErrorLabel
@onready var player_container: Node2D = $PlayerContainer

## Spawned player reference
var player: Node2D = null


func _ready() -> void:
	_update_status(\"Initializing test...\")

	# Wait for autoloads to be ready
	await get_tree().process_frame
	await get_tree().process_frame

	_start_test()


func _start_test() -> void:
	state = TestState.LOADING_CONFIG
	_update_status(\"Loading test configuration...\")

	# Load config
	config = TestConfigScript.new()
	if not config.load_config():
		_show_error(\"Failed to load .env.test file\\n\\nPlease create .env.test from .env.test.example\")
		return

	if not config.is_valid():
		_show_error(\"Invalid configuration - missing username or password\")
		return

	config.print_config()

	# Configure API URL
	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if auth_mgr:
		auth_mgr.set_api_url(config.api_server_url)

	# Start login
	_do_login()


func _do_login() -> void:
	state = TestState.LOGGING_IN
	_update_status(\"Logging in as %s...\" % config.username)

	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if not auth_mgr:
		_show_error(\"AuthManager not found\")
		return

	# Connect signals
	if not auth_mgr.login_successful.is_connected(_on_login_successful):
		auth_mgr.login_successful.connect(_on_login_successful)
	if not auth_mgr.login_failed.is_connected(_on_login_failed):
		auth_mgr.login_failed.connect(_on_login_failed)

	# Attempt login
	auth_mgr.login(config.username, config.password)


func _on_login_successful(user_data: Dictionary) -> void:
	print(\"[AutoLoginTest] Login successful: %s\" % user_data)

	# Disconnect signals
	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if auth_mgr:
		if auth_mgr.login_successful.is_connected(_on_login_successful):
			auth_mgr.login_successful.disconnect(_on_login_successful)
		if auth_mgr.login_failed.is_connected(_on_login_failed):
			auth_mgr.login_failed.disconnect(_on_login_failed)

	# Check if we have a character
	var char_name: String = user_data.get(\"character_name\", \"\")
	if char_name.is_empty():
		_show_error(\"No character found for this account.\\nPlease create a character first.\")
		return

	_update_status(\"Logged in as %s (Character: %s)\" % [user_data.get(\"username\", \"?\"), char_name])

	# Proceed to spawn player
	await get_tree().create_timer(0.5).timeout
	_spawn_player()


func _on_login_failed(error: String) -> void:
	print(\"[AutoLoginTest] Login failed: %s\" % error)

	# Disconnect signals
	var auth_mgr = get_tree().root.get_node_or_null(\"AuthManager\")
	if auth_mgr:
		if auth_mgr.login_successful.is_connected(_on_login_successful):
			auth_mgr.login_successful.disconnect(_on_login_successful)
		if auth_mgr.login_failed.is_connected(_on_login_failed):
			auth_mgr.login_failed.disconnect(_on_login_failed)

	_show_error(\"Login failed: %s\" % error)


func _spawn_player() -> void:
	state = TestState.SPAWNING_PLAYER
	_update_status(\"Spawning player...\")

	# Load and instance player scene
	var player_scene := load(\"res://scenes/shared/player/player.tscn\")
	if player_scene == null:
		_show_error(\"Failed to load player scene\")
		return

	player = player_scene.instantiate()
	player.global_position = Vector2(960, 540)  # Center of 1920x1080
	player_container.add_child(player)

	state = TestState.READY
	_update_status(\"Player spawned! Controls:\\n  WASD - Move\\n  Mouse - Aim\\n  Left Click - Shoot\\n  F3 - Debug overlay\\n  Space - Take 25 damage\\n  Escape - Reset player\")

	# Hide error label, show success
	error_label.visible = false


func _update_status(text: String) -> void:
	if status_label:
		status_label.text = text
	print(\"[AutoLoginTest] %s\" % text)


func _show_error(text: String) -> void:
	state = TestState.ERROR
	if error_label:
		error_label.text = \"ERROR: %s\" % text
		error_label.visible = true
	_update_status(\"Test failed\")
	push_error(\"[AutoLoginTest] %s\" % text)


func _input(event: InputEvent) -> void:
	if state != TestState.READY or player == null:
		return

	# Test damage
	if event.is_action_pressed(\"ui_accept\"):  # Space
		if player.has_method(\"take_damage\"):
			player.take_damage(25)
			print(\"[AutoLoginTest] Applied 25 damage, HP: %d\" % player.hp_component.current_hp)

	# Reset player
	elif event.is_action_pressed(\"ui_cancel\"):  # Escape
		if player.has_method(\"reset\"):
			player.reset()
			print(\"[AutoLoginTest] Player reset\")
"

