; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Omgea Networking"
run/main_scene="res://scenes/boot_scene.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://autoload/game_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
AuthManager="*res://autoload/auth_manager.gd"
AudioManager="*res://autoload/audio_manager.tscn"
SceneManager="*res://autoload/scene_manager.gd"
EntityNameCache="*res://autoload/entity_name_cache.gd"
EventBus="*res://autoload/event_bus.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
; Boot windowed at the small windowed-mode size (matches GameManager.WINDOWED_SMALL_SIZE), not the
; 1920x1080 render resolution. The project boots windowed on purpose (see game_manager.gd: macOS
; native-fullscreen Spaces are unreliable on the first frame); _load_settings() applies the
; saved/default window_mode at startup, so this small window is only the brief boot frame before we
; transition INTO fullscreen — keeping that transient frame unobtrusive instead of a full-screen flash.
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

